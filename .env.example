# Copy to .env and fill in ONLY if you want experimental X / Instagram feeds.
# These credentials configure the self-hosted RSSHub container.
# Never commit your real .env.

# --- X (Twitter): enables RSSHub route /twitter/user/:id ---
# RSSHub logs in with these credentials. Use a NON-IMPORTANT account:
# logins from new accounts or unusual regions may be restricted by X.
TWITTER_USERNAME=
TWITTER_PASSWORD=
# Optional: phone or email associated with the account (for login challenges)
TWITTER_PHONE_OR_EMAIL=
# Optional: 2FA TOTP secret (the part after secret= in otpauth://...)
TWITTER_AUTHENTICATION_SECRET=

# --- Instagram: enables RSSHub route /instagram/user/:id ---
# Either username+password (Private API) or a raw Cookie header value.
# Two-factor authentication is NOT supported by RSSHub's Instagram routes.
IG_USERNAME=
IG_PASSWORD=
# IG_COOKIE=sessionid=...; csrftoken=...; ds_user_id=...
# IG_PROXY=   # optional proxy URL

# --- Openfeed backend overrides (all optional) ---
# OPENFEED_RSSHUB_BASE_URL=http://localhost:1200
# OPENFEED_POLL_YOUTUBE_MIN=30
# OPENFEED_POLL_TIKTOK_MIN=60
# OPENFEED_POLL_X_MIN=90
# OPENFEED_POLL_IG_MIN=90
