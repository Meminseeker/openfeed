OPENFEED_DOMAIN=openfeed.meminseeker.com
ACME_EMAIL=you@example.com
# Required only when claiming a workspace created before individual accounts.
# Generate a long random secret, enter it on the first signup, then remove it.
OPENFEED_SETUP_TOKEN=

# Optional server-side platform credentials; leave blank for public-page mode.
X_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=

# Delete unsaved posts without notes after this many days (default: 7).
OPENFEED_RETENTION_DAYS=7
