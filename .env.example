OPENFEED_DOMAIN=openfeed.meminseeker.com
ACME_EMAIL=you@example.com
OPENFEED_AUTH_USER=alvin
# Generate with: docker run --rm -it caddy:2-alpine caddy hash-password
# Single quotes prevent Compose from interpreting $ in the bcrypt hash.
OPENFEED_AUTH_HASH='$2a$REPLACE_WITH_GENERATED_HASH'

# Optional server-side platform credentials; leave blank for public-page mode.
X_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=
